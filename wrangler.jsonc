{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anchor-tech",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "anchor-tech-staging"
    }
  }
}
